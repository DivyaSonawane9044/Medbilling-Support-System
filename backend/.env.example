# Backend configuration. Spring Boot reads these from the process environment
# (set them in your shell / IDE run config / hosting dashboard). Do not commit real values.

SERVER_PORT=8081

# Database: leave unset to use the persistent H2 file at backend/data/.
# For MySQL also start with --spring.profiles.active=mysql
DB_URL=jdbc:mysql://localhost:3306/pharmacy_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata
DB_USERNAME=medbilling
DB_PASSWORD=change-me

# Insert sample data when the database is empty (development only)
DEMO_DATA_ENABLED=false
# Or run with --spring.profiles.active=demo: seeds a separate H2 file (data/medbilling-demo) with demo data

# Clerk: Dashboard > API Keys > "Frontend API URL"
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URI=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Razorpay (test keys start with rzp_test_). Leave empty to disable online payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
